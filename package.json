{
  "name": "gymtracker-monorepo",
  "private": true,
  "version": "0.1.67",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @gymtracker/pwa",
    "build": "npm run build -w @gymtracker/pwa",
    "preview": "npm run preview -w @gymtracker/pwa",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @gymtracker/pwa"
  }
}
